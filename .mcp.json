{
  "mcpServers": {
    "jevflow": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.12",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "PyYAML>=6,<7",
        "python",
        "scripts/jevflow.py",
        "serve",
        "--trace-dir",
        "~/.local/state/jevflow/traces",
        "--web-port",
        "0"
      ],
      "cwd": "."
    }
  }
}
